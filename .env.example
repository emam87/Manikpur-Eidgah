# ==============================================================================
# Manikpur Central Shahi Eidgah — Environment Configuration Example
# Copy this file to .env in production and fill in real values.
# NEVER commit real .env or secrets to version control.
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=5000

# Client Application URL (For CORS allow-list in production)
CLIENT_URL=https://manikpureidgah.org
API_BASE_URL=https://manikpureidgah.org/api

# Database Connection (Supabase PostgreSQL / Direct URL for migrations)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Authentication & JWT Configuration
JWT_SECRET=replace-with-a-very-secure-random-secret-key-at-least-64-chars-long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-another-secure-random-secret-cookie-key

# Secret Admin Panel Path (8-40 characters, letters, numbers, and hyphens only)
# Common names like 'admin', 'login', 'dashboard', 'panel', 'wp-admin' are strictly forbidden.
ADMIN_PATH=eidgah-manage-k29x
VITE_ADMIN_PATH=eidgah-manage-k29x

# First Admin Bootstrap (Optional — used only on empty database if interactive CLI is not used)
ADMIN_BOOTSTRAP_EMAIL=admin@manikpureidgah.org
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-password-min-10-chars
ADMIN_BOOTSTRAP_NAME=Manikpur Eidgah Admin

# Cloudflare R2 Storage (S3-Compatible SDK)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BUCKET_NAME=manikpur-eidgah-public
R2_PRIVATE_BUCKET_NAME=manikpur-eidgah-private
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Rate Limiting & Safety
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_MS=900000

