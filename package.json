{
  "name": "manikpur-eidgah",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manikpur Eidgah (মানিকপুর ঈদগাহ) Web Application",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,SPA\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "admin:create": "npm run admin:create --workspace=server",
    "admin:path": "npm run admin:path --workspace=server",
    "data:import": "npm run data:import --workspace=server",
    "i18n:check": "node scripts/check-i18n.js",
    "name:check": "node scripts/check-names.js",
    "theme:check": "node scripts/check-theme.js",
    "mobile:check": "node scripts/check-mobile.js",
    "migrate:names": "node server/src/scripts/migrateOldNames.js",
    "test": "npm run test --workspace=server"
  },
  "keywords": [
    "eidgah",
    "manikpur",
    "react",
    "express",
    "prisma",
    "postgresql",
    "tailwindcss"
  ],
  "author": "Manikpur Eidgah Committee",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
