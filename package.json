{
  "name": "manikpur-eidgah",
  "version": "1.0.0",
  "private": true,
  "description": "Manikpur Central Shahi Eidgah (মানিকপুর কেন্দ্রীয় শাহী ঈদগাহ) Web Application",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "admin:create": "npm run admin:create --workspace=server",
    "admin:path": "npm run admin:path --workspace=server",
    "data:import": "npm run data:import --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "keywords": [
    "eidgah",
    "manikpur",
    "react",
    "express",
    "prisma",
    "postgresql",
    "tailwindcss"
  ],
  "author": "Manikpur Eidgah Committee",
  "license": "UNLICENSED"
}

